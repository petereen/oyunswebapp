# Rename to agent-https.conf only after the agent.oyuns.mn certificate exists.
server {
    listen 443 ssl;
    server_name agent.oyuns.mn;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/agent.oyuns.mn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agent.oyuns.mn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Docker's embedded resolver finds the Agent container after it joins the
    # external web-edge network. A variable defers lookup until request time.
    resolver 127.0.0.11 ipv6=off valid=30s;
    set $agent_upstream http://oyuns-agent-frontend:80;

    location / {
        proxy_pass $agent_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
