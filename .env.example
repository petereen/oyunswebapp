# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Frontend Supabase phone auth (Vite build-time env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Telegram Bot Configuration
# IMPORTANT: Keep this secret! Never commit the actual token to version control
BOT_TOKEN=ABCD:ADASD1234567890

# Admin Chat IDs (for notifications) - comma-separated list of Telegram chat IDs
ADMIN_CHAT_IDS=123456789,987654321

# Admin User IDs (for webapp admin access) - comma-separated list of Telegram user IDs
# These users will have access to the admin panel in the webapp
ADMIN_USER_IDS=1932946217,1447446407,5564298862,1409343588,6351681039

# Admin Panel Configuration
# LOCAL DEV:
# ADMIN_PANEL_URL=http://localhost:5173?admin=true
# USER_PANEL_URL=http://localhost:5173

# PRODUCTION (VPS):
# Replace your-domain.com with your actual domain
ADMIN_PANEL_URL=https://app.oyuns.mn/?admin=true
USER_PANEL_URL=https://app.oyuns.mn/

# If Docker nginx should be the public edge on the VPS, bind it directly on 80/443
# and stop/disable any host nginx already using those ports.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Telegram browser login
TELEGRAM_LOGIN_CLIENT_ID=your-botfather-client-id
# Optional: pin the exact BotFather Web Login redirect URI, including path and trailing slash.
# This is a frontend build-time Vite variable, so Docker Compose must rebuild the frontend image after changes.
VITE_TELEGRAM_LOGIN_REDIRECT_URI=https://app.oyuns.mn/

# Admin API Key (for admin panel authentication)
ADMIN_API_KEY=your-secure-random-admin-key

# Standalone analytics dashboard key (dashboard.oyuns.mn, no Telegram auth)
DASHBOARD_API_KEY=key

# ── Google Sheets black-rate (а ханш) for the profit calculator ──────────────
# See GOOGLE_SHEETS_SETUP.md for the full walkthrough.
# 1) Create a Google service account with the Google Sheets API enabled.
# 2) Download its JSON key file and share the sheet with the service-account email.
# 3) Point this to that JSON file. For Docker, use a path visible inside the api container.
# 4) Copy the spreadsheet id from the URL: .../spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=
BLACK_RATE_SPREADSHEET_ID=
# Tab (sheet) name that holds the rates
BLACK_RATE_SHEET_NAME=Sheet1
# Column letter with the dates (B = "Он сар") and with the black rate (I)
BLACK_RATE_DATE_COLUMN=B
BLACK_RATE_RATE_COLUMN=I
# How many header rows to skip at the top of those columns
BLACK_RATE_HEADER_ROWS=1
# Only treat a row as a rate row when this column equals this value
# (column E "Төлөв" == "Ханш"). Set BLACK_RATE_STATUS_COLUMN= (empty) to disable.
BLACK_RATE_STATUS_COLUMN=E
BLACK_RATE_STATUS_VALUE=Ханш

# Storage Buckets
# STORAGE_BUCKET_PASSPORTS=passports
# STORAGE_BUCKET_RECEIPTS=bills
